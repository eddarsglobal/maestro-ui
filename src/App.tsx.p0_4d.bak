import { useEffect, useRef, useState } from "react";
import {
  ArrowUp,
  BookOpen,
  Bot,
  CheckCircle2,
  CircleDot,
  ExternalLink,
  GitBranch,
  HelpCircle,
  LoaderCircle,
  Menu,
  MessageSquarePlus,
  Moon,
  Search,
  Settings,
  ShieldCheck,
  Sun,
  Users,
  X,
} from "lucide-react";
import "./styles/maestro.css";
import LocalRuntimePanel from "./features/settings/LocalRuntimePanel";
import {
  checkGateway,
  listGatewayModels,
  openGatewaySession,
  runGatewayMission,
} from "./services/gateway/client";
import {
  loadLocalRuntimeSettings,
  type GatewayHealth,
  type GatewayStatus,
  type LocalRuntimeSettings,
  type MissionResponse,
} from "./types/gateway";

const CORE = "https://github.com/eddarsglobal/maestro";

const councils = [
  ["EX","Executive","Direction, routing & mission lifecycle"],
  ["AY","Acceptance","Acceptance contracts & final validation"],
  ["IT","Technology","Engineering & implementation"],
  ["JR","Legal","Legal & compliance interpretation"],
  ["MK","Market","Market & marketing strategy"],
  ["CM","Creation & Media","Content, communication & media"],
  ["OP","Operations","Operations, releases & recovery"],
  ["FN","Finance","Financial analysis & constraints"],
  ["AD","Administration","Administrative & jurisdictional processes"],
  ["DA","Design","Design quality & experience"],
  ["PM","Product","Product scope & management"],
  ["CS","Customer Success","User success & usability"],
  ["DT","Data & Telemetry","Measurement & data truth"],
  ["SC","Security","Security architecture & independent audit"],
  ["TX","Traceability","Durable state & traceability"],
  ["PR","Performance","Performance & real-world evidence"],
  ["AI","Artificial Intelligence","AI architecture & model policy"],
  ["RX","Research","External research & evidence"],
];

type View = "chat" | "councils" | "help" | "settings";

type ChatItem =
  | {
      id: string;
      role: "user";
      text: string;
    }
  | {
      id: string;
      role: "maestro";
      text: string;
      mission: MissionResponse;
    }
  | {
      id: string;
      role: "error";
      text: string;
    };

function routeFromHash(): View {
  const route = window.location.hash.replace(/^#\/?/, "");

  if (route === "councils" || route === "help" || route === "settings") {
    return route;
  }

  return "chat";
}

function shortResource(resourceId: string): string {
  return resourceId.replace(/^ollama::/, "");
}

export default function App() {
  const [view, setView] = useState<View>(routeFromHash());
  const [theme, setThemeState] = useState<"dark" | "light">(
    () => localStorage.getItem("maestro-theme") === "light" ? "light" : "dark",
  );
  const [mobile, setMobile] = useState(false);
  const [prompt, setPrompt] = useState("");
  const [messages, setMessages] = useState<ChatItem[]>([]);
  const [runtimeSettings, setRuntimeSettings] =
    useState<LocalRuntimeSettings>(loadLocalRuntimeSettings);
  const [gatewayStatus, setGatewayStatus] =
    useState<GatewayStatus>("checking");
  const [gatewayHealth, setGatewayHealth] =
    useState<GatewayHealth | null>(null);
  const [models, setModels] = useState<string[]>([]);
  const [selectedModel, setSelectedModel] = useState("AUTO");
  const [running, setRunning] = useState(false);
  const sessionTokenRef = useRef<string | null>(null);

  useEffect(() => {
    const onHash = () => setView(routeFromHash());
    window.addEventListener("hashchange", onHash);
    return () => window.removeEventListener("hashchange", onHash);
  }, []);

  useEffect(() => {
    const onSettings = (event: Event) => {
      const custom = event as CustomEvent<LocalRuntimeSettings>;
      if (custom.detail) {
        setRuntimeSettings(custom.detail);
        sessionTokenRef.current = null;
      }
    };

    window.addEventListener("maestro-runtime-settings", onSettings);
    return () =>
      window.removeEventListener("maestro-runtime-settings", onSettings);
  }, []);

  useEffect(() => {
    let cancelled = false;

    const inspectRuntime = async () => {
      setGatewayStatus("checking");

      try {
        const health = await checkGateway(runtimeSettings.gatewayUrl);

        if (cancelled) return;

        setGatewayHealth(health);
        setGatewayStatus("online");

        try {
          const modelData = await listGatewayModels(
            runtimeSettings.gatewayUrl,
          );

          if (!cancelled) {
            setModels(modelData.models || []);
          }
        } catch {
          if (!cancelled) setModels([]);
        }
      } catch {
        if (cancelled) return;
        setGatewayHealth(null);
        setGatewayStatus("offline");
        setModels([]);
        sessionTokenRef.current = null;
      }
    };

    void inspectRuntime();

    return () => {
      cancelled = true;
    };
  }, [runtimeSettings.gatewayUrl]);

  const go = (next: View) => {
    setView(next);
    setMobile(false);
    window.location.hash = next === "chat" ? "#/" : `#/${next}`;
  };

  const setTheme = (next: "dark" | "light") => {
    localStorage.setItem("maestro-theme", next);
    document.documentElement.style.colorScheme = next;
    setThemeState(next);
  };

  const ensureSession = async (): Promise<string> => {
    if (sessionTokenRef.current) {
      return sessionTokenRef.current;
    }

    const session = await openGatewaySession(runtimeSettings.gatewayUrl);
    sessionTokenRef.current = session.session_token;
    return session.session_token;
  };

  const send = async () => {
    const text = prompt.trim();

    if (!text || running) return;

    const userMessage: ChatItem = {
      id: crypto.randomUUID(),
      role: "user",
      text,
    };

    setMessages((current) => [...current, userMessage]);
    setPrompt("");
    setRunning(true);

    try {
      setGatewayStatus("checking");

      const health = await checkGateway(runtimeSettings.gatewayUrl);
      setGatewayHealth(health);
      setGatewayStatus("online");

      let token = await ensureSession();

      const execute = async () =>
        runGatewayMission(
          runtimeSettings.gatewayUrl,
          token,
          {
            prompt: text,
            model: selectedModel === "AUTO" ? null : selectedModel,
            max_tokens: 512,
          },
        );

      let mission: MissionResponse;

      try {
        mission = await execute();
      } catch (error) {
        const message =
          error instanceof Error ? error.message : String(error);

        if (message.toLowerCase().includes("session")) {
          sessionTokenRef.current = null;
          token = await ensureSession();
          mission = await execute();
        } else {
          throw error;
        }
      }

      setMessages((current) => [
        ...current,
        {
          id: crypto.randomUUID(),
          role: "maestro",
          text: mission.output,
          mission,
        },
      ]);
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : "Unknown MAESTRO Gateway error";

      setGatewayStatus("offline");
      sessionTokenRef.current = null;

      setMessages((current) => [
        ...current,
        {
          id: crypto.randomUUID(),
          role: "error",
          text: message,
        },
      ]);
    } finally {
      setRunning(false);
    }
  };

  const runtimeLabel =
    gatewayStatus === "online"
      ? "ONLINE"
      : gatewayStatus === "checking"
        ? "CHECKING"
        : "OFFLINE";

  return (
    <div className="app" data-theme={theme}>
      <aside className={"sidebar " + (mobile ? "open" : "")}>
        <div className="brandRow">
          <button className="brand" onClick={() => go("chat")}>
            <span className="logo">M</span>
            <span>
              <b>MAESTRO</b>
              <small>SOVEREIGN CONTROL PLANE</small>
            </span>
          </button>

          <button
            className="icon mobileOnly"
            onClick={() => setMobile(false)}
            aria-label="Close navigation"
          >
            <X size={18} />
          </button>
        </div>

        <button
          className="newChat"
          onClick={() => {
            setMessages([]);
            go("chat");
          }}
        >
          <MessageSquarePlus size={17} />
          New chat
        </button>

        <label className="search">
          <Search size={15} />
          <input placeholder="Search" />
        </label>

        <div className="section">
          <span className="label">RECENTS</span>
          <button>Local model orchestration</button>
          <button>Council architecture</button>
          <button>Governed mission design</button>
        </div>

        <div className="grow" />

        <nav>
          <button
            className={view === "councils" ? "active" : ""}
            onClick={() => go("councils")}
          >
            <Users size={17} />
            Councils
            <em>18</em>
          </button>

          <button
            className={view === "help" ? "active" : ""}
            onClick={() => go("help")}
          >
            <HelpCircle size={17} />
            Help
          </button>

          <a href={CORE} target="_blank" rel="noreferrer">
            <GitBranch size={17} />
            GitHub
            <ExternalLink size={13} />
          </a>

          <button
            className={view === "settings" ? "active" : ""}
            onClick={() => go("settings")}
          >
            <Settings size={17} />
            Settings
          </button>
        </nav>
      </aside>

      {mobile && (
        <button className="scrim" onClick={() => setMobile(false)} />
      )}

      <main>
        <header>
          <div>
            <button
              className="icon mobileOnly"
              onClick={() => setMobile(true)}
              aria-label="Open navigation"
            >
              <Menu size={18} />
            </button>

            <button
              className={`runtime runtime-${gatewayStatus}`}
              onClick={() => go("settings")}
              title="Open Local Runtime settings"
            >
              <i />
              LOCAL RUNTIME
              <b>{runtimeLabel}</b>
            </button>
          </div>

          <div className="headerRight">
            {gatewayHealth?.version && (
              <span className="coreVersion">
                CORE {gatewayHealth.version}
              </span>
            )}

            <span className="local">
              <ShieldCheck size={15} />
              Local-first
            </span>

            <button
              className="icon"
              onClick={() =>
                setTheme(theme === "dark" ? "light" : "dark")
              }
              aria-label="Toggle theme"
            >
              {theme === "dark" ? <Sun size={17} /> : <Moon size={17} />}
            </button>
          </div>
        </header>

        {view === "chat" && (
          <section className="chat">
            {messages.length === 0 ? (
              <div className="hero">
                <span className="heroLogo">M</span>
                <small>SOVEREIGN ARTIFICIAL INTELLIGENCE</small>
                <h1>What would you like MAESTRO to accomplish?</h1>
                <p>
                  Models provide intelligence. MAESTRO retains authority,
                  orchestration, evidence and verification.
                </p>

                <div className="actions">
                  <button onClick={() => go("councils")}>
                    <Users size={16} />
                    Explore Councils
                  </button>

                  <a
                    href={CORE + "/blob/main/README.md"}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <BookOpen size={16} />
                    Core specification
                  </a>
                </div>
              </div>
            ) : (
              <div className="missionConversation">
                {messages.map((message) => {
                  if (message.role === "user") {
                    return (
                      <div className="chatRow chatRowUser" key={message.id}>
                        <div className="chatAvatar">
                          <CircleDot size={17} />
                        </div>
                        <div className="chatBubble userBubble">
                          <span className="chatRole">YOU</span>
                          <p>{message.text}</p>
                        </div>
                      </div>
                    );
                  }

                  if (message.role === "error") {
                    return (
                      <div className="chatRow" key={message.id}>
                        <div className="chatAvatar errorAvatar">
                          <X size={17} />
                        </div>
                        <div className="chatBubble errorBubble">
                          <span className="chatRole">GATEWAY ERROR</span>
                          <p>{message.text}</p>
                        </div>
                      </div>
                    );
                  }

                  return (
                    <div className="chatRow" key={message.id}>
                      <div className="chatAvatar maestroAvatar">
                        <Bot size={17} />
                      </div>

                      <div className="chatBubble maestroBubble">
                        <div className="answerHeader">
                          <span className="chatRole">MAESTRO</span>

                          <span className="verifiedChip">
                            <CheckCircle2 size={13} />
                            AY {message.mission.ay_verdict} · DELIVERY
                          </span>
                        </div>

                        <p className="maestroOutput">{message.text}</p>

                        <div className="missionStages">
                          {message.mission.stages.map((stage) => (
                            <span key={stage}>{stage}</span>
                          ))}
                        </div>

                        <div className="missionMetaGrid">
                          <div>
                            <span>MODE</span>
                            <b>{message.mission.mode}</b>
                          </div>
                          <div>
                            <span>MODEL</span>
                            <b>{shortResource(message.mission.resource_id)}</b>
                          </div>
                          <div>
                            <span>TASK</span>
                            <b>{message.mission.task_id}</b>
                          </div>
                          <div>
                            <span>EVIDENCE</span>
                            <b>{message.mission.evidence_id}</b>
                          </div>
                          <div>
                            <span>TX</span>
                            <b>
                              {message.mission.tx_committed
                                ? "COMMITTED"
                                : "NOT COMMITTED"}
                            </b>
                          </div>
                          <div>
                            <span>LATENCY</span>
                            <b>
                              {typeof message.mission.metrics.total_ms === "number"
                                ? `${(Number(message.mission.metrics.total_ms) / 1000).toFixed(1)}s`
                                : "—"}
                            </b>
                          </div>
                          <div>
                            <span>TRUTH SCOPE</span>
                            <b>
                              {message.mission.semantic_truth_verified
                                ? "SEMANTIC VERIFIED"
                                : "DELIVERY ONLY"}
                            </b>
                          </div>
                        </div>
                      </div>
                    </div>
                  );
                })}

                {running && (
                  <div className="chatRow">
                    <div className="chatAvatar maestroAvatar">
                      <LoaderCircle className="spin" size={17} />
                    </div>

                    <div className="chatBubble missionRunning">
                      <span className="chatRole">MAESTRO</span>
                      <div className="runningLine">
                        <LoaderCircle className="spin" size={15} />
                        Governed mission in progress
                      </div>
                      <div className="runningStages">
                        UNDERSTANDING → CONTRACT → ROUTING → CONDUCTING →
                        VERIFYING → TX
                      </div>
                    </div>
                  </div>
                )}
              </div>
            )}

            <div className="composerWrap">
              <div className="composer">
                <textarea
                  value={prompt}
                  disabled={running}
                  onChange={(event) => setPrompt(event.target.value)}
                  onKeyDown={(event) => {
                    if (
                      event.key === "Enter" &&
                      !event.shiftKey &&
                      !running
                    ) {
                      event.preventDefault();
                      void send();
                    }
                  }}
                  placeholder={
                    gatewayStatus === "offline"
                      ? "Connect MAESTRO Local Gateway to continue..."
                      : "Ask MAESTRO..."
                  }
                  rows={1}
                />

                <div className="composerBottom">
                  <div className="composerControls">
                    <select
                      value={selectedModel}
                      onChange={(event) =>
                        setSelectedModel(event.target.value)
                      }
                      disabled={running || gatewayStatus !== "online"}
                      title="Local model"
                    >
                      <option value="AUTO">AUTO · MAESTRO SELECTS</option>
                      {models.map((model) => (
                        <option value={model} key={model}>
                          {model}
                        </option>
                      ))}
                    </select>

                    <span>
                      {gatewayStatus === "online"
                        ? `${models.length} local models`
                        : "Gateway not connected"}
                    </span>
                  </div>

                  <button
                    onClick={() => void send()}
                    disabled={
                      !prompt.trim() ||
                      running ||
                      gatewayStatus !== "online"
                    }
                    aria-label="Send to MAESTRO"
                  >
                    {running ? (
                      <LoaderCircle className="spin" size={17} />
                    ) : (
                      <ArrowUp size={17} />
                    )}
                  </button>
                </div>
              </div>

              <small>
                Your intelligence stays on your machine. MAESTRO controls the
                mission lifecycle.
              </small>
            </div>
          </section>
        )}

        {view === "councils" && (
          <section className="page">
            <small>GOVERNED DOMAINS</small>
            <h2>Genesis Councils</h2>
            <p>
              Councils define responsibility, authority and expected evidence
              inside MAESTRO.
            </p>

            <div className="grid">
              {councils.map(([code, name, domain]) => (
                <a
                  key={code}
                  className="council"
                  href={`${CORE}/blob/main/blueprints/Council-${code.toLowerCase()}.md`}
                  target="_blank"
                  rel="noreferrer"
                >
                  <strong>{code}</strong>
                  <span>
                    <b>{name}</b>
                    <small>{domain}</small>
                  </span>
                  <ExternalLink size={14} />
                </a>
              ))}
            </div>

            <div className="principle">
              MAESTRO COMMANDS MODELS. MODELS DO NOT COMMAND MAESTRO.
            </div>
          </section>
        )}

        {view === "help" && (
          <section className="page">
            <small>DOCUMENTATION</small>
            <h2>Help & resources</h2>

            <div className="resourceGrid">
              <a href={CORE + "#quick-installation"} target="_blank" rel="noreferrer">
                <BookOpen />
                <b>Getting started</b>
                <span>Install and validate MAESTRO Core.</span>
              </a>

              <a
                href={CORE + "/blob/main/docs/COUNCILS.md"}
                target="_blank"
                rel="noreferrer"
              >
                <Users />
                <b>Councils</b>
                <span>Explore all 18 governed domains.</span>
              </a>

              <a
                href={CORE + "/blob/main/docs/LOCAL_AI.md"}
                target="_blank"
                rel="noreferrer"
              >
                <ShieldCheck />
                <b>Local AI</b>
                <span>Ollama and local intelligence.</span>
              </a>

              <a href={CORE + "/issues"} target="_blank" rel="noreferrer">
                <GitBranch />
                <b>Issues</b>
                <span>Report defects and propose improvements.</span>
              </a>
            </div>
          </section>
        )}

        {view === "settings" && (
          <section className="page settingsPage">
            <small>LOCAL CONFIGURATION</small>
            <h2>Settings</h2>
            <p>
              Configure the local browser-to-MAESTRO boundary. These values
              stay on this device.
            </p>

            <div className="appearanceBar">
              <span>
                <b>Appearance</b>
                <small>Local UI theme</small>
              </span>

              <div>
                <button
                  className={theme === "dark" ? "selected" : ""}
                  onClick={() => setTheme("dark")}
                >
                  Dark
                </button>

                <button
                  className={theme === "light" ? "selected" : ""}
                  onClick={() => setTheme("light")}
                >
                  Light
                </button>
              </div>
            </div>

            <LocalRuntimePanel />
          </section>
        )}
      </main>
    </div>
  );
}
